# 复制为 .env.local 后按需修改。修改后需要重新 `npm run build` 才会生效。

# —— 留言板数据源（可选）——
# 不配置时：留言保存在浏览器 localStorage，纯静态托管即可用。
# 配置后：留言走 REST 服务，实现跨设备持久化 + 服务端鉴权。
# VITE_GUESTBOOK_API=http://localhost:3000

# —— 管理端口令（可选）——
# 仅在「本地存储模式」下用于演示登录流程；接入后端后由服务端自己的 ADMIN_PASSWORD 决定。
# VITE_ADMIN_PASSWORD=wsy2026

# —— GitHub Pages 子路径（可选）——
# 默认与仓库名一致；若 fork 后改名，通过该变量覆盖。
# PAGES_BASE=/新的仓库名/
